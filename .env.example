AGENT_WORKER_API_KEY=replace-with-a-long-random-secret
AGENT_USER_EMAIL=agent@office.local
AGENT_USER_PASSWORD=replace-with-a-strong-password

# Credential the agent worker hands pi when its model is an Anthropic one. Set
# ONE of these. A workspace agent configured on the Agents page takes precedence.
#   ANTHROPIC_API_KEY        — pay-as-you-go API credit
#   CLAUDE_CODE_OAUTH_TOKEN  — Claude subscription, from `claude setup-token`
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# The other two vendors pi can run on.
OPENAI_API_KEY=
GEMINI_API_KEY=

# The pi runtime sits on top of a vendor the workspace chooses, so its model
# setting names one as well. Recognised prefixes are anthropic:, openai: and
# google:; a bare id is read as an Anthropic model. It falls back to the matching
# credential above when the workspace agent has none, CLAUDE_CODE_OAUTH_TOKEN
# included on an Anthropic model.
PI_MODEL=anthropic:claude-opus-5

# Agent worker browser tuning. The worker keeps an editor page open after a task
# finishes and reuses it for the next task on the same document, which skips the
# whole editor load. Set AGENT_SESSION_MAX=0 to go back to one page per task.
AGENT_SESSION_MAX=3
AGENT_SESSION_IDLE_MS=300000
# Playwright tracing: off | failures | always. Recording costs time on every
# browser action, so "off" is the fastest and "always" the most debuggable.
AGENT_TRACE=failures
# Interaction pacing in milliseconds. Raise AGENT_TYPE_DELAY_MS (the old value was
# 12) if the editor drops characters while the agent types.
AGENT_TYPE_DELAY_MS=4
AGENT_KEY_DELAY_MS=40
AGENT_WRITE_SETTLE_MS=120
AGENT_READY_SETTLE_MS=1500
# JPEG quality of the screenshots sent to the model on every turn.
AGENT_SCREENSHOT_QUALITY=60
